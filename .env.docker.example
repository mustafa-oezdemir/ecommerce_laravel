# -----------------------------------------------------------------------------
# Docker Compose
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ecommerce-laravel
APP_PORT=8000
VITE_PORT=5173
FORWARD_DB_PORT=3306
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025

# -----------------------------------------------------------------------------
# Laravel application
# Generate APP_KEY with:
# docker compose run --rm --no-deps app php artisan key:generate --force
# -----------------------------------------------------------------------------
APP_NAME="Laravel Ecommerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
ADMIN_EMAILS=admin@example.com
SEED_USER_PASSWORD=change-this-seed-password

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# MySQL
# Replace every example password before using this outside local development.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=change-this-local-password
DB_ROOT_PASSWORD=change-this-local-root-password

# -----------------------------------------------------------------------------
# State and background jobs
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# -----------------------------------------------------------------------------
# MailHog (development only)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Vite
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_HMR_HOST=localhost
VITE_HMR_PORT=5173

# -----------------------------------------------------------------------------
# Optional production integrations
# Keep real credentials in GitHub Secrets or your deployment platform.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
